# Pinned Node runtime.
FROM node:22-bookworm-slim

ENV NODE_ENV=development
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json* /app/
RUN npm ci || npm install

COPY . /app
CMD ["bash"]
